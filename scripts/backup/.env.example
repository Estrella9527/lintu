# 灵图备份系统配置示例
# 部署：cp .env.example .env && chmod 600 .env
# .env 永远不入 git（已在 .gitignore 排除）

# ── PG 连接 ──
LINTU_PG_HOST=127.0.0.1
LINTU_PG_PORT=5432
LINTU_PG_USER=lintu
LINTU_PG_DB=lintu
PGPASSWORD=changeme

# ── 加密密钥（任意强字符串，生成方法：openssl rand -hex 32）──
LINTU_BACKUP_KEY=changeme-please-generate-with-openssl-rand

# ── OSS ──
LINTU_BACKUP_OSS_BUCKET=lintu-backups
LINTU_BACKUP_OSS_PATH=lintu-backups/pg

# ── 本地 ──
LINTU_BACKUP_LOCAL_DIR=/var/backups/lintu
LINTU_BACKUP_RETAIN_DAYS=7
