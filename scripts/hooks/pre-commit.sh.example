#!/usr/bin/env bash
# 灵图本地 pre-commit 敏感串拦截 — 零外部依赖（纯 grep）
#
# 任何 staged 改动包含黑名单串都拒绝 commit。
# 优先用 gitleaks（更精细），找不到就用本地 grep 兜底。

set -e

# ── 1) 优先用 gitleaks ─────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --no-banner -c .gitleaks.toml 2>&1 || {
        echo ""
        echo "❌ gitleaks 命中敏感串。修复后再 commit。"
        echo "   绕过（仅紧急情况）: git commit --no-verify"
        exit 1
    }
    exit 0
fi

# ── 2) gitleaks 不可用时用本地 grep 兜底 ──────────────────────────────
# ── 把 docs/internal/（本地，.gitignore）里的真值填到这里 ────────
# 例如：
#   '<PROD_IP_REGEX>'                 # 真实 ECS IP
#   '(api|ugc)\.<PROD_DOMAIN_REGEX>' # 真实生产子域
#   '<CUSTOMER_BUCKET>'                # 客户 OSS bucket
#   '<CUSTOMER_PROJECT_UUID_A>'        # 项目 UUID
#   '<CUSTOMER_SCENIC_NAME>'           # 客户景区名
PATTERNS=(
  # 通用规则（无真值，所有人都能用）
  'LTAI[0-9A-Za-z]{16,30}'                          # 阿里云 RAM AK
  'AKIA[0-9A-Z]{16}'                                # AWS AK
  'ghp_[A-Za-z0-9]{36}'                             # GitHub PAT
  'sk-[A-Za-z0-9]{32,}'                             # OpenAI/Anthropic API key
  '-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY-----' # 私钥
  # 仓库特有黑名单（从 docs/internal/ 拿真值，本地填）
  # '<REAL_IP_PATTERN>'
  # '(api|ugc)\.<REAL_DOMAIN_PATTERN>'
  # '<CUSTOMER_BUCKET_PATTERN>'
  # '<CUSTOMER_UUID_PATTERN>'
  # '<CUSTOMER_NAME_PATTERN>'
)

# 排除 docs/internal/（本地映射，本来就 .gitignore）
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^docs/internal/' || true)
if [ -z "$STAGED" ]; then exit 0; fi

HITS=""
for p in "${PATTERNS[@]}"; do
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        # 只在文本文件查找（跳过二进制）
        if file "$f" 2>/dev/null | grep -q text; then
            if git diff --cached -- "$f" | grep -E "^\+.*$p" >/dev/null 2>&1; then
                HITS="$HITS\n  $f → $p"
            fi
        fi
    done <<< "$STAGED"
done

if [ -n "$HITS" ]; then
    echo "❌ pre-commit 检测到敏感串（不能 commit）："
    echo -e "$HITS"
    echo ""
    echo "如果是真值（基础设施 / 客户名），请放到 docs/internal/（已 gitignore）"
    echo "如果是误报，绕过命令: git commit --no-verify"
    exit 1
fi

exit 0
