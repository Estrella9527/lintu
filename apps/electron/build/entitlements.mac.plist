<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron's V8 engine compiles JS to native code at runtime; without
         these two entitlements the hardened runtime kills the renderer. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading the bundled PyInstaller sidecar (which is signed
         independently of the main Electron app's code-signing identity).
         Without this, dyld refuses to load the sidecar's Python interpreter
         and the FastAPI server never starts. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The sidecar binds 127.0.0.1:7879 (network.server) and reaches out
         to OSS / Volcengine APIs (network.client). Both required. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- File access. The user picks directories for image scan / export
         via NSOpenPanel; once granted, we need to read/write within them. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
