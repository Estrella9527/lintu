{
  "name": "@lintu/electron",
  "version": "0.2.1",
  "private": true,
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:main": "node scripts/build-main.mjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "bun run build:main && bun run build:preload && bun run build:renderer",
    "build:user": "LINTU_BUILD_FLAVOR=user bun run build",
    "build:ops":  "LINTU_BUILD_FLAVOR=ops  bun run build",
    "start": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "gen:api-types": "bash scripts/gen-api-types.sh",
    "check:api-types": "bash scripts/gen-api-types.sh --check"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "jotai": "^2.16.0",
    "lucide-react": "^0.561.0",
    "motion": "^12.23.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.0",
    "vite": "^6.2.4"
  }
}
