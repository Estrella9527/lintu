# Copy to .env and fill in. Used by deploy/docker-compose.yml.

# ── PostgreSQL (cloud sidecar storage) ────────────────────────────────────
POSTGRES_USER=lintu
POSTGRES_DB=lintu
# REQUIRED: choose a long random string. Don't reuse from elsewhere.
POSTGRES_PASSWORD=change_me_to_a_long_random_string

# ── Internal sync (local sidecar → cloud sidecar) ─────────────────────────
# REQUIRED: same value must be set on the local sidecar's environment as
# LINTU_INTERNAL_SYNC_TOKEN. Long random string, treat as a secret.
LINTU_INTERNAL_SYNC_TOKEN=change_me_to_a_long_random_string

# ── CORS (UGC frontend domains) ───────────────────────────────────────────
# Comma-separated. Wildcards like *.example.com supported.
# Example:  https://ugc.example.com,*.example.com
LINTU_ALLOW_CORS=

# ── Audit ─────────────────────────────────────────────────────────────────
# 1 = capture request bodies in api_request_logs (useful for hard-query
# reverse lookup); 0 = only log meta. Default 0 for privacy.
LINTU_AUDIT_BODY=0

# ── Provider (optional — required if cloud needs to embed query text) ────
# The cloud sidecar must be able to embed UGC's text into the SAME vector
# space as the images. Easiest: configure the same Ark relay you use locally.
# Format:  relay:<relay_name>
LINTU_DEFAULT_IMAGE_EMBEDDING_PROVIDER=
# Custom relay JSON list. Example:
#   [{"name":"ark","base_url":"https://ark.cn-beijing.volces.com/api/v3","api_key":"sk-xxx","model":"doubao-embedding-vision-251215"}]
LINTU_CUSTOM_RELAYS=
